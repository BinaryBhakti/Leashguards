# Copy this file to .env.local and fill values locally.
# Never commit real API keys or service account paths.

LEASHGUARDS_LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-new-gemini-api-key

# Optional Google Document AI scanned-PDF OCR
GOOGLE_CLOUD_PROJECT_ID=replace-with-project-id
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=replace-with-processor-id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional local JSON encryption
LEASHGUARDS_STORAGE_KEY=replace-with-long-random-secret
